# NetInsight-X Environment Variables — copy to .env and fill in as needed.
# Every variable below has a safe default for local/demo use; nothing here is required to run
# the server locally with `python manage.py runserver`.

# ==========================================
# Django Core
# ==========================================
# DJANGO_SECRET_KEY=change-me-to-a-random-32+-character-string
# DEBUG=True
# ALLOWED_HOSTS=*

# ==========================================
# Database (defaults to local SQLite if unset)
# ==========================================
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ==========================================
# Agent Authentication
# ==========================================
# Shared secret the server requires (and both agent/ and agent_go/ now send) as the
# X-Agent-Token header. Must be set to the SAME value in the server's .env and each agent's
# own environment for registration/telemetry to succeed once enforcement is on.
# NETINSIGHT_AGENT_TOKEN=
# NETINSIGHT_ENFORCE_AGENT_TOKEN=False

# ==========================================
# Dashboard User Authentication
# ==========================================
# When True, all dashboard pages and read-only APIs require an authenticated Django user
# (agent ingestion endpoints are unaffected — they use NETINSIGHT_AGENT_TOKEN instead).
# NETINSIGHT_REQUIRE_AUTH=False

# ==========================================
# Transport Security (opt-in — see netinsight/config/settings.py)
# ==========================================
# Enable only when this server sits behind TLS termination (reverse proxy / load balancer).
# NETINSIGHT_FORCE_HTTPS=False
# NETINSIGHT_SSL_REDIRECT=True
# NETINSIGHT_HSTS_SECONDS=31536000

# ==========================================
# Demo / Replay Mode
# ==========================================
# NETINSIGHT_DEMO_MODE=True

# ==========================================
# Capture & Telemetry
# ==========================================
# NETINSIGHT_INTERFACE=
# NETINSIGHT_LINK_CAPACITY=100000000
# NETINSIGHT_REFRESH_INTERVAL=1000
# NETINSIGHT_MDP_GAMMA=0.90

# ==========================================
# Server-Sent Events (live dashboard stream)
# ==========================================
# Bounds concurrent /api/v1/stream/metrics/ connections and each stream's max lifetime, so a
# burst of dashboard viewers degrades gracefully (503) instead of exhausting all WSGI workers.
# NETINSIGHT_MAX_SSE_CONNECTIONS=4
# NETINSIGHT_SSE_MAX_DURATION=300

# ==========================================
# Async Telemetry Processing
# ==========================================
# Caps in-flight background analytics tasks; once reached, a tick's heavy processing is
# skipped (agent status is still saved) rather than queuing without bound.
# NETINSIGHT_MAX_INFLIGHT_TELEMETRY_TASKS=16
# NETINSIGHT_PRUNE_INTERVAL_SECONDS=60

# ==========================================
# Dynamic Link-Speed Detection
# ==========================================
# NETINSIGHT_ENABLE_EXTERNAL_SPEEDTEST=False
# NETINSIGHT_SPEEDTEST_INTERVAL=300

# ==========================================
# Logging
# ==========================================
# NETINSIGHT_LOG_LEVEL=INFO

# ==========================================
# Edge Agents (agent/ Python, agent_go/ Go)
# ==========================================
# NOTE: only the SERVER's settings.py auto-loads a .env file at the project root. Agents read
# OS environment variables directly — export these in the agent's own shell/environment (or use
# a process manager / systemd unit / .bat wrapper) rather than expecting this .env file to be
# picked up automatically when running agent/main.py or agent_go's binary.
# NETINSIGHT_SERVER_URL=http://localhost:8000
# NETINSIGHT_AGENT_TOKEN=            # must match the server's NETINSIGHT_AGENT_TOKEN above
# NETINSIGHT_AGENT_INTERVAL=1.0
# NETINSIGHT_AGENT_INTERFACE=
# NETINSIGHT_HOTSPOT_SSID=
# HOTSPOT_SSID=                      # Go agent equivalent of NETINSIGHT_HOTSPOT_SSID
