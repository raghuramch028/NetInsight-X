# NetInsight-X Runtime Environment Configuration

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-netinsightx-production-secret-change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Agent Authentication Token (Optional: Unset runs in open local dev mode)
NETINSIGHT_AGENT_TOKEN=your-secret-agent-token-here

# Database Configuration
# Local SQLite Default:
NETINSIGHT_DB_PATH=netinsight/database/netinsight.db
# Remote PostgreSQL (Neon Cloud / Production):
# DATABASE_URL=postgres://user:password@ep-host.neon.tech/netinsight?sslmode=require

# Machine Learning & Intrusion Detection Models
NETINSIGHT_SVM_PATH=netinsight/classification/svm_model.joblib

# Logging & Operations
NETINSIGHT_LOG_LEVEL=INFO
